# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# PostgreSQL (use Railway's private DATABASE_URL in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Admin sessions — generate a random value of at least 32 characters
SESSION_SECRET=replace-with-a-random-secret

# One-time administrator bootstrap — remove after creating the first owner
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_NAME=Store Owner
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-restricted-public-token
MAPBOX_ACCESS_TOKEN=your-private-server-token

# Gmail SMTP order notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=store@example.com
SMTP_APP_PASSWORD=your-google-app-password
ORDER_NOTIFICATION_TO=store@example.com
ORDER_NOTIFICATION_FROM=store@example.com
