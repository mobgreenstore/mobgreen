generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WeightUnit {
  G
  KG
}

enum Currency {
  GBP
  EUR
  USD
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  RECHARGE_FROM_STORE
  RECHARGE_ONLINE
  BITCOIN_DEPOSIT
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum CategoryDisplayTone {
  LIGHT
  MIST
  STONE
  CHARCOAL
  INK
}

enum AdminRole {
  OWNER
  MANAGER
  EDITOR
  VIEWER
}

enum PublicRequestScope {
  GEOCODING
  CUSTOMER_ORDERS
}

enum DeliveryTrackingState {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum DeliveryRouteKind {
  DRIVING
  DIRECT_FALLBACK
}

enum CheckoutIntentStatus {
  DRAFT
  MATCHING
  DRIVER_SELECTED
  SUBMITTED
  EXPIRED
}

enum SpecialOfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum OrderNotificationKind {
  ADMIN_ORDER_SUBMITTED
}

model AdminUser {
  id                       String                         @id @default(uuid()) @db.Uuid
  email                    String                         @unique @db.VarChar(320)
  passwordHash             String                         @db.VarChar(255)
  name                     String                         @db.VarChar(120)
  isActive                 Boolean                        @default(true)
  role                     AdminRole                      @default(VIEWER)
  sessionVersion           Int                            @default(1)
  lastLoginAt              DateTime?                      @db.Timestamptz(3)
  createdAt                DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                       @updatedAt @db.Timestamptz(3)
  statusEvents             OrderStatusEvent[]
  paymentStatusEvents      OrderPaymentStatusEvent[]
  verificationAccessEvents OrderVerificationAccessEvent[]

  @@index([isActive])
  @@map("admin_users")
}

model AdminLoginThrottle {
  keyHash         String    @id @db.VarChar(64)
  failedAttempts  Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([lockedUntil])
  @@map("admin_login_throttles")
}

model Category {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.VarChar(120)
  slug          String               @unique @db.VarChar(140)
  description   String?              @db.VarChar(500)
  imagePublicId String?              @unique @db.VarChar(255)
  imageUrl      String?              @db.Text
  imageAltText  String?              @db.VarChar(255)
  imageWidth    Int?
  imageHeight   Int?
  position      Int                  @default(0)
  displayTone   CategoryDisplayTone  @default(MIST)
  isActive      Boolean              @default(true)
  archivedAt    DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  products      Product[]
  offerPolicy   CategoryOfferPolicy?
  specialOffers SpecialOffer[]

  @@index([isActive, position])
  @@index([archivedAt])
  @@map("categories")
}

model Product {
  id               String               @id @default(uuid()) @db.Uuid
  categoryId       String               @db.Uuid
  name             String               @db.VarChar(160)
  slug             String               @unique @db.VarChar(180)
  shortDescription String               @db.VarChar(280)
  description      String?              @db.Text
  status           ProductStatus        @default(DRAFT)
  archivedAt       DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  priceOptions     ProductPriceOption[]
  orderItems       OrderItem[]
  specialOffers    SpecialOffer[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([archivedAt])
  @@map("products")
}

model ProductImage {
  id                 String   @id @default(uuid()) @db.Uuid
  productId          String   @db.Uuid
  cloudinaryPublicId String   @unique @db.VarChar(255)
  url                String   @db.Text
  altText            String   @db.VarChar(255)
  width              Int
  height             Int
  position           Int      @default(0)
  isCover            Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId, isCover])
  @@map("product_images")
}

model ProductPriceOption {
  id                  String         @id @default(uuid()) @db.Uuid
  productId           String         @db.Uuid
  weightValue         Decimal        @db.Decimal(12, 3)
  weightUnit          WeightUnit
  currency            Currency
  priceMinor          BigInt
  compareAtPriceMinor BigInt?
  costMinor           BigInt?
  position            Int            @default(0)
  isActive            Boolean        @default(true)
  archivedAt          DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]
  specialOffers       SpecialOffer[]

  @@unique([productId, weightValue, weightUnit, currency])
  @@index([productId, isActive, position])
  @@index([archivedAt])
  @@map("product_price_options")
}

model Order {
  id                        String                         @id @default(uuid()) @db.Uuid
  reference                 String                         @unique @db.VarChar(32)
  customerName              String                         @db.VarChar(120)
  customerPhone             String?                        @db.VarChar(40)
  customerEmail             String?                        @db.VarChar(320)
  fulfillmentType           FulfillmentType
  deliveryAddress           String?                        @db.Text
  deliveryPostalCode        String?                        @db.VarChar(32)
  deliveryLocality          String?                        @db.VarChar(120)
  deliveryCountryCode       String?                        @db.Char(2)
  destinationLatitude       Decimal?                       @db.Decimal(10, 7)
  destinationLongitude      Decimal?                       @db.Decimal(10, 7)
  destinationMapboxPlaceId  String?                        @db.VarChar(255)
  customerNote              String?                        @db.VarChar(1000)
  currency                  Currency
  subtotalMinor             BigInt
  deliveryFeeMinor          BigInt                         @default(0)
  totalMinor                BigInt
  status                    OrderStatus                    @default(PENDING)
  paymentStatus             PaymentStatus                  @default(UNPAID)
  paymentMethod             PaymentMethod
  rechargeProvider          String?                        @db.VarChar(40)
  verificationCodeEncrypted String?                        @db.Text
  idempotencyKey            String?                        @unique @db.Uuid
  guestSessionId            String?                        @db.Uuid
  archivedAt                DateTime?                      @db.Timestamptz(3)
  createdAt                 DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                       @updatedAt @db.Timestamptz(3)
  items                     OrderItem[]
  statusEvents              OrderStatusEvent[]
  paymentStatusEvents       OrderPaymentStatusEvent[]
  notifications             OrderNotification[]
  verificationAccessEvents  OrderVerificationAccessEvent[]
  guestSession              GuestSession?                  @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  deliveryTracking          DeliveryTracking?
  checkoutIntentId          String?                        @unique @db.Uuid
  checkoutIntent            CheckoutIntent?                @relation(fields: [checkoutIntentId], references: [id], onDelete: SetNull)
  courierProfileIdSnapshot  String?                        @db.VarChar(64)
  courierNameSnapshot       String?                        @db.VarChar(80)
  courierDistanceMeters     Int?
  courierDurationSeconds    Int?

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentType, createdAt])
  @@index([currency, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([guestSessionId, createdAt])
  @@index([archivedAt])
  @@map("orders")
}

model DeliveryTracking {
  id                       String                @id @default(uuid()) @db.Uuid
  orderId                  String                @unique @db.Uuid
  originLatitude           Decimal               @db.Decimal(10, 7)
  originLongitude          Decimal               @db.Decimal(10, 7)
  destinationLatitude      Decimal               @db.Decimal(10, 7)
  destinationLongitude     Decimal               @db.Decimal(10, 7)
  routeGeometry            Json
  routeDistanceMeters      Int
  estimatedDurationSeconds Int
  dispatchedAt             DateTime              @db.Timestamptz(3)
  estimatedArrivalAt       DateTime              @db.Timestamptz(3)
  routeProviderId          String                @db.VarChar(120)
  routeKind                DeliveryRouteKind
  state                    DeliveryTrackingState @default(ACTIVE)
  lastProviderError        String?               @db.VarChar(255)
  createdAt                DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime              @updatedAt @db.Timestamptz(3)
  order                    Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([state, dispatchedAt])
  @@index([estimatedArrivalAt])
  @@map("delivery_tracking")
}

model OrderItem {
  id                              String              @id @default(uuid()) @db.Uuid
  orderId                         String              @db.Uuid
  productId                       String?             @db.Uuid
  priceOptionId                   String?             @db.Uuid
  specialOfferId                  String?             @db.Uuid
  productNameSnapshot             String              @db.VarChar(160)
  productImageUrlSnapshot         String?             @db.Text
  productImageAltTextSnapshot     String?             @db.VarChar(255)
  productImagePublicIdSnapshot    String?             @db.VarChar(255)
  weightValueSnapshot             Decimal             @db.Decimal(12, 3)
  weightUnitSnapshot              WeightUnit
  currencySnapshot                Currency
  unitPriceMinor                  BigInt
  quantity                        Int
  lineTotalMinor                  BigInt
  offerOriginalTotalMinorSnapshot BigInt?
  offerDiscountBpsSnapshot        Int?
  offerDiscountMinorSnapshot      BigInt?
  offerTotalMinorSnapshot         BigInt?
  offerBundleQuantitySnapshot     Int?
  offerEndsAtSnapshot             DateTime?           @db.Timestamptz(3)
  createdAt                       DateTime            @default(now()) @db.Timestamptz(3)
  order                           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                         Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  priceOption                     ProductPriceOption? @relation(fields: [priceOptionId], references: [id], onDelete: SetNull)
  specialOffer                    SpecialOffer?       @relation(fields: [specialOfferId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([priceOptionId])
  @@index([specialOfferId])
  @@map("order_items")
}

model OrderStatusEvent {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @db.Uuid
  fromStatus       OrderStatus?
  toStatus         OrderStatus
  note             String?      @db.VarChar(1000)
  changedByAdminId String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByAdmin   AdminUser?   @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByAdminId])
  @@map("order_status_events")
}

model CheckoutThrottle {
  keyHash         String    @id @db.VarChar(64)
  requestCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([blockedUntil])
  @@map("checkout_throttles")
}

model OrderPaymentStatusEvent {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @db.Uuid
  fromStatus       PaymentStatus?
  toStatus         PaymentStatus
  note             String?        @db.VarChar(1000)
  changedByAdminId String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByAdmin   AdminUser?     @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByAdminId])
  @@map("order_payment_status_events")
}

model GuestSession {
  id              String           @id @default(uuid()) @db.Uuid
  tokenHash       String           @unique @db.VarChar(64)
  expiresAt       DateTime         @db.Timestamptz(3)
  lastSeenAt      DateTime         @default(now()) @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  orders          Order[]
  checkoutIntents CheckoutIntent[]

  @@index([expiresAt])
  @@map("guest_sessions")
}

model CheckoutIntent {
  id                       String               @id @default(uuid()) @db.Uuid
  publicId                 String               @unique @db.VarChar(64)
  guestSessionId           String               @db.Uuid
  idempotencyKey           String               @unique @db.Uuid
  status                   CheckoutIntentStatus @default(DRAFT)
  customerName             String               @db.VarChar(120)
  customerEmail            String               @db.VarChar(320)
  fulfillmentType          FulfillmentType
  paymentMethod            PaymentMethod
  rechargeProvider         String?              @db.VarChar(40)
  cartLines                Json
  currency                 Currency
  subtotalMinor            BigInt
  deliveryAddress          String?              @db.Text
  deliveryPostalCode       String?              @db.VarChar(32)
  deliveryLocality         String?              @db.VarChar(120)
  deliveryCountryCode      String?              @db.Char(2)
  destinationLatitude      Decimal?             @db.Decimal(10, 7)
  destinationLongitude     Decimal?             @db.Decimal(10, 7)
  destinationMapboxPlaceId String?              @db.VarChar(255)
  candidateSet             Json?
  selectedCourierProfileId String?              @db.VarChar(64)
  selectedCourierName      String?              @db.VarChar(80)
  selectedDistanceMeters   Int?
  selectedDurationSeconds  Int?
  expiresAt                DateTime             @db.Timestamptz(3)
  submittedAt              DateTime?            @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(3)
  guestSession             GuestSession         @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  order                    Order?

  @@index([guestSessionId, createdAt])
  @@index([status, expiresAt])
  @@map("checkout_intents")
}

model OrderNotification {
  id                String                  @id @default(uuid()) @db.Uuid
  orderId           String                  @db.Uuid
  kind              OrderNotificationKind
  recipient         String                  @db.VarChar(320)
  sender            String                  @db.VarChar(320)
  status            OrderNotificationStatus @default(PENDING)
  attemptCount      Int                     @default(0)
  providerMessageId String?                 @db.VarChar(255)
  lastError         String?                 @db.VarChar(500)
  lastAttemptAt     DateTime?               @db.Timestamptz(3)
  sentAt            DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind, recipient])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@map("order_notifications")
}

model OrderVerificationAccessEvent {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid
  adminUserId String    @db.Uuid
  occurredAt  DateTime  @default(now()) @db.Timestamptz(3)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@index([adminUserId, occurredAt])
  @@map("order_verification_access_events")
}

model PublicRequestThrottle {
  scope           PublicRequestScope
  keyHash         String             @db.VarChar(64)
  requestCount    Int                @default(0)
  windowStartedAt DateTime           @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)

  @@id([scope, keyHash])
  @@index([windowStartedAt])
  @@map("public_request_throttles")
}

model CategoryOfferPolicy {
  id                      String   @id @default(uuid()) @db.Uuid
  categoryId              String   @unique @db.Uuid
  enabled                 Boolean  @default(false)
  minimumWeightGrams      Int      @default(80)
  maximumWeightGrams      Int      @default(1000)
  minimumDiscountBps      Int      @default(300)
  maximumDiscountBps      Int      @default(1500)
  minimumMarginBps        Int      @default(1500)
  durationMinutes         Int      @default(1440)
  maxOffersPerPriceOption Int      @default(4)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  category                Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("category_offer_policies")
}

model SpecialOffer {
  id                 String             @id @default(uuid()) @db.Uuid
  publicId           String             @unique @db.VarChar(64)
  generationKey      String             @db.Uuid
  categoryId         String             @db.Uuid
  productId          String             @db.Uuid
  priceOptionId      String             @db.Uuid
  currency           Currency
  bundleQuantity     Int
  totalWeightGrams   Decimal            @db.Decimal(12, 3)
  originalTotalMinor BigInt
  discountBps        Int
  discountMinor      BigInt
  offerTotalMinor    BigInt
  status             SpecialOfferStatus @default(DRAFT)
  startsAt           DateTime           @db.Timestamptz(3)
  endsAt             DateTime           @db.Timestamptz(3)
  archivedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceOption        ProductPriceOption @relation(fields: [priceOptionId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]

  @@unique([generationKey, priceOptionId, bundleQuantity])
  @@index([categoryId, status, endsAt])
  @@index([productId, status, endsAt])
  @@index([priceOptionId])
  @@index([generationKey])
  @@index([endsAt])
  @@map("special_offers")
}

model StoreSettings {
  id                     String     @id @default("default") @db.VarChar(32)
  storeName              String     @default("MOB GREENS") @db.VarChar(120)
  supportPhone           String?    @db.VarChar(40)
  supportedCurrencyCodes Currency[] @default([GBP, EUR, USD])
  orderPrefix            String     @default("MG") @db.VarChar(10)
  pickupInstructions     String?    @db.Text
  deliveryEnabled        Boolean    @default(true)
  dispatchAddress        String?    @db.Text
  dispatchLatitude       Decimal?   @db.Decimal(10, 7)
  dispatchLongitude      Decimal?   @db.Decimal(10, 7)
  dispatchMapboxPlaceId  String?    @db.VarChar(255)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  @@map("store_settings")
}
