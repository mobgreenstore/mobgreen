{
  "name": "mob-greens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names database,admin,store npm:db:tunnel \"sh -c 'sleep 5 && npm run dev:admin'\" \"sh -c 'sleep 5 && npm run dev:store'\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:health": "NODE_OPTIONS=--conditions=react-server tsx scripts/db-health.ts",
    "mail:health": "NODE_OPTIONS=--conditions=react-server tsx scripts/mail-health.ts",
    "postinstall": "prisma generate",
    "db:tunnel": "railway connect Postgres --tunnel-only --ssh --port 15432",
    "admin:bootstrap": "NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap-admin.ts",
    "dev:admin": "MOB_GREENS_SURFACE=admin next dev --port 3000",
    "dev:store": "MOB_GREENS_SURFACE=store next dev --port 3001",
    "build:admin": "MOB_GREENS_SURFACE=admin next build",
    "build:store": "MOB_GREENS_SURFACE=store next build",
    "start:admin": "MOB_GREENS_SURFACE=admin next start --port 3000",
    "start:store": "MOB_GREENS_SURFACE=store next start --port 3001",
    "dev:apps": "concurrently --kill-others-on-fail --names admin,store npm:dev:admin npm:dev:store",
    "test:responsive": "node scripts/validate-catalog-responsive.mjs"
  },
  "dependencies": {
    "@mapbox/search-js-react": "^1.6.0",
    "@next/env": "^16.3.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.1",
    "next": "16.3.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "puppeteer-core": "^19.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
